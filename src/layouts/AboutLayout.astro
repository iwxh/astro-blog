---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";
export interface Props {
  frontmatter: { title: string; description?: string };
}
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav="about" />
  <main id="main-content" class="about-shell page-width">
    <header>
      <span class="eyebrow">ABOUT TARAM</span><h1>{frontmatter.title}</h1><p>
        一座安放日常、思考与文字的线上庄园。
      </p>
    </header>
    <section id="about" class="prose paper-panel"><slot /></section>
  </main>
  <Footer />
</Layout>

<style>
  .about-shell {
    @apply max-w-4xl py-14 sm:py-20;
  }
  .about-shell header {
    @apply mb-9 text-center;
  }
  .about-shell h1 {
    @apply font-serif text-4xl font-semibold tracking-[.1em] sm:text-5xl;
  }
  .about-shell header p {
    @apply mt-4 opacity-60;
  }
  #about {
    @apply px-6 py-9 sm:px-12 sm:py-12;
  }
</style>
