---
import { SITE } from "@config";
import LinkButton from "./LinkButton.astro";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;
---

<header class="site-header">
  <a id="skip-to-content" href="#main-content">跳到正文</a>
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.title}首页`}>
      <span class="brand-mark" aria-hidden="true">❦</span>
      <span>{SITE.title}</span>
    </a>

    <nav id="nav-menu" aria-label="主导航">
      <button
        class="hamburger-menu focus-outline"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          class="menu-icon"
        >
          <line x1="4" y1="7" x2="20" y2="7" class="line"></line>
          <line x1="4" y1="12" x2="20" y2="12" class="line"></line>
          <line x1="4" y1="17" x2="20" y2="17" class="line"></line>
          <line x1="5" y1="5" x2="19" y2="19" class="close"></line>
          <line x1="19" y1="5" x2="5" y2="19" class="close"></line>
        </svg>
      </button>

      <ul id="menu-items" class="display-none sm:flex">
        <li><a href="/" class={!activeNav ? "active" : ""}>首页</a></li>
        <li>
          <a href="/posts/" class={activeNav === "posts" ? "active" : ""}
            >文章</a
          >
        </li>
        <li>
          <a href="/tags/" class={activeNav === "tags" ? "active" : ""}>标签</a>
        </li>
        <li>
          <a href="/about/" class={activeNav === "about" ? "active" : ""}
            >关于</a
          >
        </li>
        <li class="utility-link">
          <LinkButton
            href="/search/"
            className={activeNav === "search" ? "active" : ""}
            ariaLabel="搜索文章"
            title="搜索"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
              ><path
                d="M10.5 3a7.5 7.5 0 1 0 4.73 13.32L20.91 22 22 20.91l-5.68-5.68A7.5 7.5 0 0 0 10.5 3Zm0 2a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11Z"
              ></path></svg
            >
            <span>搜索</span>
          </LinkButton>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="utility-link">
              <button
                id="theme-btn"
                class="focus-outline"
                title="切换明暗模式"
                aria-label="切换明暗模式"
                aria-live="polite"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  id="moon-svg"
                  viewBox="0 0 24 24"
                >
                  <path d="M20.7 15.4A8 8 0 0 1 8.6 3.3 9 9 0 1 0 20.7 15.4Z" />
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  id="sun-svg"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0-5h1v3h-2V2h1Zm0 17h1v3h-2v-3h1ZM2 11h3v2H2v-2Zm17 0h3v2h-3v-2ZM4.2 5.6l1.4-1.4 2.1 2.1-1.4 1.4-2.1-2.1Zm12.1 12.1 1.4-1.4 2.1 2.1-1.4 1.4-2.1-2.1Zm2.1-13.5 1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1ZM6.3 16.3l1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1Z" />
                </svg>
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    @apply sticky top-0 z-40 border-b border-skin-line bg-skin-fill;
    background-color: rgba(var(--color-fill), 0.92);
    backdrop-filter: blur(18px);
  }
  #skip-to-content {
    @apply absolute -top-full left-5 z-50 rounded-full bg-skin-accent px-4 py-2 text-sm text-skin-inverted focus:top-3;
  }
  .header-inner {
    @apply mx-auto flex min-h-[4.75rem] w-full max-w-6xl items-center justify-between px-5 sm:px-8;
  }
  .brand {
    @apply flex items-center gap-2 font-serif text-xl font-semibold tracking-[.12em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-skin-fill sm:text-2xl;
  }
  .brand-mark {
    @apply text-2xl;
    color: rgb(var(--color-accent));
    transform: rotate(-18deg);
  }
  nav {
    @apply flex items-center;
  }
  nav ul {
    @apply items-center gap-1 sm:gap-2;
  }
  nav li {
    @apply flex items-center;
  }
  nav a,
  nav button {
    @apply relative rounded-full px-3 py-2 text-sm transition-colors hover:text-skin-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-skin-fill;
  }
  nav a.active {
    @apply text-skin-accent;
  }
  nav a.active::after {
    content: "";
    @apply absolute bottom-0.5 left-1/2 h-px w-5 -translate-x-1/2;
    background: rgb(var(--color-gold));
  }
  .utility-link {
    @apply ml-1 border-l border-skin-line pl-2;
  }
  .utility-link a {
    @apply flex items-center gap-1.5;
  }
  .utility-link svg,
  #theme-btn svg {
    @apply h-5 w-5;
  }
  .hamburger-menu {
    @apply p-2 sm:hidden;
  }
  .hamburger-menu svg {
    @apply h-6 w-6 fill-transparent stroke-current;
  }
  .menu-icon line {
    @apply transition-opacity;
  }
  .menu-icon .close {
    opacity: 0;
  }
  .menu-icon.is-active .line {
    opacity: 0;
  }
  .menu-icon.is-active .close {
    opacity: 1;
  }
  @media (max-width: 639px) {
    nav ul {
      @apply absolute left-5 right-5 top-[4.9rem] flex-col rounded-2xl border border-skin-line bg-skin-card p-3 shadow-xl;
    }
    nav li,
    nav li a {
      @apply w-full;
    }
    nav li a {
      @apply justify-center text-center;
    }
    nav a.active::after {
      @apply hidden;
    }
    .utility-link {
      @apply ml-0 border-l-0 pl-0;
    }
    #theme-btn {
      @apply w-full;
    }
  }
</style>

<script>
  function toggleNav() {
    const button = document.querySelector<HTMLButtonElement>(".hamburger-menu");
    const icon = document.querySelector(".menu-icon");
    const items = document.querySelector("#menu-items");
    button?.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") === "true";
      icon?.classList.toggle("is-active");
      button.setAttribute("aria-expanded", expanded ? "false" : "true");
      button.setAttribute("aria-label", expanded ? "打开菜单" : "关闭菜单");
      items?.classList.toggle("display-none");
    });
  }
  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
