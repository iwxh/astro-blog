---
export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
}
const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="pagination-wrapper" aria-label="分页导航">
      {currentPage > 1 ? (
        <a href={prevUrl}>← 上一页</a>
      ) : (
        <span aria-disabled="true">← 上一页</span>
      )}
      <strong>
        {currentPage} <i>/</i> {totalPages}
      </strong>
      {currentPage < totalPages ? (
        <a href={nextUrl}>下一页 →</a>
      ) : (
        <span aria-disabled="true">下一页 →</span>
      )}
    </nav>
  )
}

<style>
  .pagination-wrapper {
    @apply mx-auto mt-8 flex w-full max-w-6xl items-center justify-center gap-5 px-5 sm:px-8;
  }
  .pagination-wrapper a,
  .pagination-wrapper span {
    @apply rounded-full border border-skin-line px-4 py-2 text-sm;
  }
  .pagination-wrapper a {
    @apply hover:border-skin-accent hover:text-skin-accent;
  }
  .pagination-wrapper span {
    @apply cursor-not-allowed opacity-35;
  }
  .pagination-wrapper strong {
    @apply text-sm font-normal;
  }
  .pagination-wrapper i {
    @apply mx-1 not-italic opacity-35;
  }
</style>
