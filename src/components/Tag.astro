---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}
const { tag, size = "sm" } = Astro.props;
---

<li class="tag-item">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={["tag-link", { large: size === "lg" }]}
    ><span aria-hidden="true">#</span>{tag}</a
  >
</li>

<style>
  .tag-item {
    @apply inline-block;
  }
  .tag-link {
    @apply inline-flex items-center gap-1 rounded-full border border-skin-line bg-skin-card px-3 py-1 text-sm transition-all hover:-translate-y-0.5 hover:border-skin-accent hover:text-skin-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-skin-fill;
  }
  .tag-link span {
    color: rgb(var(--color-gold));
  }
  .tag-link.large {
    @apply px-5 py-2.5 text-base;
  }
</style>
