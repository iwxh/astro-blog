---
import { getCollection } from "astro:content";
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SearchBar from "@components/Search";
import getSortedPosts from "@utils/getSortedPosts";
const sortedPosts = getSortedPosts(await getCollection("blog"));
const searchList = sortedPosts.map(({ data, slug }) => ({
  title: data.title,
  description: data.description,
  data,
  slug,
}));
---

<Layout title={`搜索 | ${SITE.title}`}>
  <Header activeNav="search" />
  <Main pageTitle="搜索" pageDesc="在庄园的文字中，寻找你感兴趣的内容。">
    <SearchBar client:load searchList={searchList} />
  </Main>
  <Footer />
</Layout>

<style is:global>
  .search-area {
    max-width: 54rem;
  }
  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 1rem;
    background: rgb(var(--color-card));
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .search-box:focus-within {
    border-color: rgb(var(--color-accent));
    box-shadow: 0 0 0 4px rgba(var(--color-accent), 0.08);
  }
  .search-box svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    opacity: 0.55;
  }
  .search-box input {
    width: 100%;
    border: 0;
    background: transparent;
    font-size: 1rem;
    outline: none;
    color: rgb(var(--color-text-base));
  }
  .search-box input::placeholder {
    opacity: 0.45;
  }
  .result-count {
    margin: 1.5rem 0 1rem;
    font-size: 0.875rem;
    opacity: 0.65;
  }
  .search-results {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .empty-search {
    margin-top: 2rem;
    padding: 3rem 1rem;
    border: 1px dashed rgb(var(--color-border));
    border-radius: 1.25rem;
    text-align: center;
  }
  .empty-search span {
    display: block;
    color: rgb(var(--color-gold));
    font-size: 2.5rem;
  }
  .empty-search strong {
    display: block;
    margin-top: 0.5rem;
    font-family: "Noto Serif SC", serif;
  }
  .empty-search p {
    margin-top: 0.5rem;
    opacity: 0.55;
  }
  @media (max-width: 767px) {
    .search-results {
      grid-template-columns: 1fr;
    }
  }
</style>
